{
  "manifest_version": 3,
  "name": "Asistente Sedes Electrónicas",
  "version": "1.0.0",
  "description": "Asistente conversacional local para tramites administrativos en sedes electronicas del Gobierno de España.",

  "permissions": [
    "activeTab",
    "storage"
  ],

  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_title": "Asistente Sedes"
  }
}
